<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran unique du convertisseur :
    - zone haute bleu turquoise (affichage des devises, montant, résultat) ;
    - zone basse claire contenant le clavier numérique 4 x 3.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond_clair"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ==================== Zone d'affichage (environ 45 % de l'écran) ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/zone_affichage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bleu_turquoise"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvTitre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/titre"
                android:textColor="@color/blanc"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Les deux listes et le bouton d'inversion -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spDeviseSource"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_bg"
                    android:contentDescription="@string/description_devise_source"
                    android:entries="@array/devises"
                    tools:entries="@array/devises" />

                <ImageButton
                    android:id="@+id/btnInverser"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:contentDescription="@string/description_inverser"
                    android:src="@drawable/ic_inverser"
                    tools:ignore="UseAppTint" />

                <Spinner
                    android:id="@+id/spDeviseCible"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_bg"
                    android:contentDescription="@string/description_devise_cible"
                    android:entries="@array/devises" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMontant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:contentDescription="@string/description_montant"
                android:gravity="end"
                android:textColor="@color/blanc"
                android:textSize="48sp"
                tools:text="0" />

            <TextView
                android:id="@+id/tvResultat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/description_resultat"
                android:gravity="end"
                android:textColor="@color/blanc"
                android:textSize="48sp"
                tools:text="102.56" />

            <Button
                android:id="@+id/btnConvertir"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/blanc"
                android:text="@string/convertir"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ==================== Clavier numérique 4 x 3 ==================== -->
    <TableLayout
        android:id="@+id/clavier"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:paddingTop="6dp"
        app:layout_constraintBottom_toTopOf="@+id/tvEtatTaux"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/zone_affichage">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnKey7"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_7"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKey8"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_8"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKey9"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_9"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnKey4"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_4"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKey5"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_5"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKey6"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_6"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnKey1"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_1"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKey2"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_2"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKey3"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_3"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <Button
                android:id="@+id/btnKeyC"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_effacer"
                android:textColor="@color/rouge_effacer"
                android:textSize="32sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnKey0"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_0"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />

            <Button
                android:id="@+id/btnKeyPoint"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/touche_point"
                android:textColor="@color/bleu_chiffre"
                android:textSize="32sp" />
        </TableRow>
    </TableLayout>

    <!-- État des taux : indique la source et permet de charger les taux réels -->
    <TextView
        android:id="@+id/tvEtatTaux"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/taux_fixes"
        android:textColor="@color/gris_texte"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
